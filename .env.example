# Reference only - nothing loads this file. The real templates are
# backend/.env.example (-> backend/.env.local, holds OPENAI_API_KEY) and
# frontend/.env.example (-> frontend/.env.local, holds ONLY VITE_API_URL).
# Never put OPENAI_API_KEY in any frontend env file: every VITE_* value is
# bundled into the browser JavaScript.

# Backend
BACKEND_PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Database (SQLite file, path relative to backend/prisma/ -> backend/data/dev.db)
DATABASE_URL="file:../data/dev.db"

# Authentication
# REQUIRED: replace with your own random secret (32+ characters). The backend
# refuses to start with this placeholder. See backend/.env.example.
JWT_SECRET=your_jwt_secret_here_generate_with_crypto.randomBytes(32).toString('hex')
# All expiries are in SECONDS
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800
BCRYPT_SALT_ROUNDS=12

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Logging
LOG_LEVEL=debug
