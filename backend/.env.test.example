# Copy to .env.test - used automatically when NODE_ENV=test (vitest sets this)
# Tests use their own SQLite file, never the dev database. `npm test`
# deletes and re-migrates it before every run, and tests/setup.ts refuses
# to run against any other file.

BACKEND_PORT=3002
NODE_ENV=test
FRONTEND_URL=http://localhost:5173

# Path is relative to backend/prisma/, so this is backend/data/test.db.
DATABASE_URL="file:../data/test.db"

# Test-only value for the throwaway test database. It is public, so the
# backend accepts it only with NODE_ENV=test (the test runner) and refuses
# it for development or production - never copy it into .env.local.
JWT_SECRET=test_jwt_secret_minimum_32_characters_long_xx
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800
BCRYPT_SALT_ROUNDS=4

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LOG_LEVEL=error
