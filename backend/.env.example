# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# Server
BACKEND_PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database: SQLite file, no server or credentials needed.
# The path is relative to backend/prisma/, so this is backend/data/dev.db.
DATABASE_URL="file:../data/dev.db"

# Authentication
# REQUIRED: replace this placeholder with your own random secret (32+ characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The backend refuses to start while JWT_SECRET is missing, blank, shorter
# than 32 characters, or still a placeholder from this file or the docs.
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
# All expiries are in SECONDS
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800
BCRYPT_SALT_ROUNDS=12

# LLM (OpenAI) - backend only. Never put the key in frontend/.env* files.
# Leave empty until you have a key: the server still starts, and agent calls
# fail with OPENAI_API_KEY_MISSING (no request is sent to OpenAI).
OPENAI_API_KEY=
# Any Chat Completions model. Costs are only computed for models listed in
# src/config/modelPricing.ts (others are logged with cost = unknown).
OPENAI_MODEL=gpt-4o

# Optional per-user AI rate limit (defaults shown). Counts AI runs started
# through the API - a CV batch counts one per file - over a sliding window;
# above it the API returns 429 with Retry-After. Kept in memory, per process.
# AI_RATE_LIMIT_MAX_RUNS=60
# AI_RATE_LIMIT_WINDOW_SECONDS=600

# Logging
LOG_LEVEL=debug
